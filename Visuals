    <script>
        let charts = {};
        
        const colors = {
            primary: '#b6b09f',
            success: '#4a5d4a',
            warning: '#8b6914',
            background: 'rgba(182, 176, 159, 0.1)'
        };

        // Navigation
        function showPage(pageId) {
            document.querySelectorAll('.page-content').forEach(page => {
                page.classList.remove('active');
            });
            
            document.getElementById(pageId + '-page').classList.add('active');
            
            document.querySelectorAll('.nav-link').forEach(link => {
                link.classList.remove('active');
            });
            
            document.querySelector(`[data-page="${pageId}"]`).classList.add('active');
            
            if (pageId === 'sensitivity') {
                setTimeout(() => initializeSensitivityChart(), 100);
            } else if (pageId === 'valuation') {
                setTimeout(() => initializeCharts(), 100);
            }
        }

        function initializeNavigation() {
            document.querySelectorAll('.nav-link').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const pageId = this.getAttribute('data-page');
                    showPage(pageId);
                });
            });
        }

        // Chart Management
        function showChart(chartType) {
            // Update tab buttons
            document.querySelectorAll('.tab-button').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
            
            // Show corresponding chart
            document.querySelectorAll('.chart-canvas').forEach(canvas => {
                canvas.classList.remove('active');
            });
            
            const chartMap = {
                'revenue': 'revenueChart',
                'fcf': 'fcfChart', 
                'margins': 'marginsChart',
                'valuation': 'valuationChart'
            };
            
            document.getElementById(chartMap[chartType]).classList.add('active');
            
            // Initialize chart if needed
            if (!charts[chartType]) {
                initializeChart(chartType);
            }
        }

        function initializeChart(type) {
            const canvasId = type + 'Chart';
            const canvas = document.getElementById(canvasId);
            if (!canvas || typeof Chart === 'undefined') return;

            const chartConfigs = {
                revenue: {
                    type: 'line',
                    data: {
                        labels: ['2024', '2025', '2026', '2027', '2028', 'Terminal'],
                        datasets: [{
                            label: 'Revenue ($B)',
                            data: [9.28, 10.76, 12.27, 13.37, 14.44, 15.02],
                            borderColor: colors.primary,
                            backgroundColor: colors.background,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) { return '
                                 + value + 'B'; }
                                }
                            }
                        }
                    }
                },
                fcf: {
                    type: 'bar',
                    data: {
                        labels: ['2024', '2025', '2026', '2027', '2028'],
                        datasets: [{
                            label: 'Free Cash Flow ($B)',
                            data: [0.74, 0.84, 0.98, 1.24, 1.50],
                            backgroundColor: colors.success
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) { return '
                                 + value + 'B'; }
                                }
                            }
                        }
                    }
                },
                margins: {
                    type: 'line',
                    data: {
                        labels: ['2024', '2025', '2026', '2027', '2028', 'Terminal'],
                        datasets: [{
                            label: 'EBIT Margin (%)',
                            data: [15.0, 15.5, 16.0, 16.5, 17.0, 17.5],
                            borderColor: colors.warning,
                            backgroundColor: 'rgba(139, 105, 20, 0.1)',
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: false,
                                min: 14,
                                max: 18,
                                ticks: {
                                    callback: function(value) { return value + '%'; }
                                }
                            }
                        }
                    }
                },
                valuation: {
                    type: 'doughnut',
                    data: {
                        labels: ['Operating Assets', 'Net Debt', 'Terminal Value'],
                        datasets: [{
                            data: [56.8, -3.9, 25.5],
                            backgroundColor: [colors.success, colors.warning, colors.primary]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                }
            };

            if (charts[type]) {
                charts[type].destroy();
            }
            
            charts[type] = new Chart(canvas, chartConfigs[type]);
        }

        function initializeCharts() {
            // Initialize the default revenue chart
            initializeChart('revenue');
        }

        // Sensitivity Analysis
        function runSensitivityAnalysis() {
            const loading = document.getElementById('sensitivityLoading');
            if (loading) {
                loading.classList.add('show');
                setTimeout(() => {
                    initializeSensitivityChart();
                    loading.classList.remove('show');
                }, 2000);
            }
        }

        function initializeSensitivityChart() {
            const canvas = document.getElementById('sensitivityChart');
            if (canvas && typeof Chart !== 'undefined') {
                if (charts.sensitivity) charts.sensitivity.destroy();
                
                charts.sensitivity = new Chart(canvas, {
                    type: 'bar',
                    data: {
                        labels: ['Terminal Growth', 'WACC', 'Revenue Growth', 'Operating Margin', 'Tax Rate'],
                        datasets: [{
                            label: 'Impact on Equity Value ($B)',
                            data: [18.2, -15.7, 12.6, 9.8, -3.9],
                            backgroundColor: [
                                colors.success,
                                colors.warning,
                                colors.primary,
                                colors.success,
                                colors.warning
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return (value > 0 ? '+
                                 : '-
                                ) + Math.abs(value) + 'B';
                                    }
                                }
                            }
                        }
                    }
                });
            }
        }

        // DCF Calculation (simplified for demo)
        function calculateValuation() {
            const loading = document.getElementById('chartsLoading');
            if (loading) {
                loading.classList.add('show');
                setTimeout(() => {
                    // Update summary cards with calculated values
                    updateSummaryCards();
                    // Initialize charts
                    initializeCharts();
                    loading.classList.remove('show');
                }, 1500);
            }
        }

        function updateSummaryCards() {
            // In a real implementation, this would perform actual DCF calculations
            // For demo purposes, we'll just update with sample values
            const updates = {
                'equity-value-main': '$78.4B',
                'firm-value-main': '$82.3B', 
                'operating-assets-main': '$86.2B',
                'price-per-share-main': '$2,847',
                'equity-change': '+2.5% vs. Market',
                'upside-potential': '2.5% Upside'
            };
            
            Object.entries(updates).forEach(([id, value]) => {
                const element = document.getElementById(id);
                if (element) element.textContent = value;
            });
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            initializeNavigation();
            initializeCharts();
        });
